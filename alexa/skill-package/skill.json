{
  "manifest": {
    "publishingInformation": {
      "locales": {
        "en-US": {
          "name": "KidEase",
          "summary": "Find daycare spots and hear updates.",
          "description": "Find open daycare spots by city. Linked parents hear how many day log entries they have today. Linked daycare staff hear new message counts. Child names are never read aloud.",
          "examplePhrases": [
            "Alexa, open kid ease",
            "Alexa, ask kid ease to find spots near me in Winnipeg",
            "Alexa, ask kid ease for new messages"
          ],
          "keywords": [
            "daycare",
            "childcare"
          ]
        },
        "en-CA": {
          "name": "KidEase",
          "summary": "Find daycare spots and hear updates.",
          "description": "Find open daycare spots by city. Child names are never read aloud.",
          "examplePhrases": [
            "Alexa, open kid ease"
          ],
          "keywords": [
            "daycare"
          ]
        },
        "fr-CA": {
          "name": "KidEase",
          "summary": "Trouvez des places en garderie.",
          "description": "Trouvez des places en garderie par ville. Les noms des enfants ne sont jamais lus à voix haute.",
          "examplePhrases": [
            "Alexa, ouvre kid ease"
          ],
          "keywords": [
            "garderie"
          ]
        }
      },
      "isAvailableWorldwide": false,
      "distributionCountries": [
        "CA",
        "US"
      ],
      "category": "EDUCATION_AND_REFERENCE"
    },
    "privacyAndCompliance": {
      "allowsPurchases": false,
      "usesPersonalInfo": true,
      "isChildDirected": false,
      "isExportCompliant": true,
      "containsAds": false,
      "locales": {
        "en-US": {
          "privacyPolicyUrl": "https://kidease.ca/privacy"
        },
        "en-CA": {
          "privacyPolicyUrl": "https://kidease.ca/privacy"
        },
        "fr-CA": {
          "privacyPolicyUrl": "https://kidease.ca/fr/privacy"
        }
      }
    },
    "apis": {
      "custom": {
        "endpoint": {
          "uri": "https://kidease.ca/api/alexa",
          "sslCertificateType": "Trusted"
        }
      }
    },
    "manifestVersion": "1.0"
  }
}