# Production (Vercel) — server env only. Never prefix these with VITE_.
# Never commit real values. Set the same keys in the Vercel project
# (Production + Preview) as encrypted environment variables.
# Canonical store: 1Password Environments (KidEase Production / Preview).
# Names-only map + Kyle checklist: docs/1password-environments.md
#   npm run ops:1password-checklist

# Neon Postgres (same key on Production + Preview). Leave commented here.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
#
# Licensed listings: Neon is SoT once public daycares >= 10000 (auto).
# CATALOG_SOURCE=auto
# CATALOG_SOURCE=neon
# CATALOG_SOURCE=json
# NEON_CATALOG_MIN_COUNT=10000
# Optional offline blank-only contact fill. Never commit the master CSV.
# MASTER_CSV_PATH=

# Required: session signing across serverless instances. Mint with
# `openssl rand -hex 32` and paste into Vercel — do not put the value here.
# Better Auth reads BETTER_AUTH_SECRET only (not AUTH_SECRET).
# Rotating it drops sessions, not password hashes on account.password.
BETTER_AUTH_SECRET=

# One-shot operator password (kyle@kidease.ca / ADMIN_EMAIL). Server env only.
# Set on Vercel Production, redeploy, sign in on www, then delete the var.
# Never prefix with VITE_. Never commit a value.
# OPERATOR_RESET_EMAIL=kyle@kidease.ca
# OPERATOR_RESET_PASSWORD=

# Native Sign in with Google (Better Auth socialProviders.google).
# Callback path (already registered on the GCP KidEase web client):
#   https://kidease.ca/api/auth/callback/google
#   https://www.kidease.ca/api/auth/callback/google
#   https://kidease-git.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Native Sign in with Facebook (Better Auth socialProviders.facebook).
# Facebook App ID → FACEBOOK_CLIENT_ID, App Secret → FACEBOOK_CLIENT_SECRET.
# Callback path (register as Valid OAuth Redirect URIs on the Meta app):
#   https://kidease.ca/api/auth/callback/facebook
#   https://www.kidease.ca/api/auth/callback/facebook
#   https://kidease-git.vercel.app/api/auth/callback/facebook
# Local: http://localhost:8080/api/auth/callback/facebook
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Optional public origin override. Dynamic baseURL already allows kidease.ca.
# BETTER_AUTH_URL=https://kidease.ca

# Grok auth broker — keep these on Grok live preview / grok.me only.
# Do not set the preview client on Vercel; production uses native Google / Facebook above.
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=
# GROK_AUTH_ISSUER=https://auth.grok.me

# Support desk (/support*). profiles.role = support | support_lead | admin.
# Case inbox is support@kidease.ca (refunds are a billing case type, not refund@).
# Cloudflare Access already guards /admin*; add /support* on www later (docs/support.md).
# Agents: live refunds capped by this (cents). support_lead and admin are unlimited.
# SUPPORT_REFUND_MAX_CENTS=10000
# Promote staff by role — do not invent a second auth table:
#   update profiles set role = 'support' where user_id = '…';
#   update profiles set role = 'support_lead' where user_id = '…';

# /admin is gated on profiles.role = 'admin', not this inbox.
# ADMIN_EMAIL is promoted only when Better Auth emailVerified is true.
# After the first verified owner session, add staff by role — do not change env:
#   update profiles set role = 'admin' where user_id = '…';
# ADMIN_EMAIL=kyle@kidease.ca

# Admin → Mail (Titan for kyle@kidease.ca). Production already has TITAN_APP_PASSWORD.
# Use a Titan app password (not the account password) when 2FA is on.
# Username is the mailbox email (TITAN_USER / ADMIN_EMAIL). Never commit the value.
# Hosts default to Titan: IMAP imap.titan.email:993 SSL, SMTP smtp.titan.email:465 SSL
# (or TITAN_SMTP_PORT=587 for STARTTLS).
# TITAN_APP_PASSWORD=
# TITAN_USER=kyle@kidease.ca
# TITAN_IMAP_HOST=imap.titan.email
# TITAN_IMAP_PORT=993
# TITAN_SMTP_HOST=smtp.titan.email
# TITAN_SMTP_PORT=465
# MAIL_FROM=KidEase <kyle@kidease.ca>
# Aliases also accepted: TITAN_PASSWORD / IMAP_PASSWORD, IMAP_USER, IMAP_HOST, SMTP_HOST.

# Stripe (add when you are ready to take live parent payments and daycare payouts).
# Leave blank (or use sk_test_) to keep the KidEase ledger as
# "Internal ledger (not charged)". Only sk_live_ keys turn charges on.
# Do not mix test and live. Never commit real secret values.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional. Paste Stripe’s Apple Pay domain-association file (plain text)
# AFTER account verification: Dashboard → Settings → Payment methods →
# Apple Pay → Add domain www.kidease.ca (and kidease.ca if used). Hosted
# Checkout already shows Apple Pay on checkout.stripe.com without this.
# Unset → /.well-known/apple-developer-merchantid-domain-association is 404.
# Do not invent the file. This is not a secret key.
# STRIPE_APPLE_PAY_DOMAIN_ASSOCIATION=
STRIPE_CONNECT_CLIENT_ID=
# Basis points kept by KidEase on each parent bill (300 = 3%).
# Daycare-paid via Stripe Connect when sk_live_ is set and the centre is connected.
KIDEASE_PLATFORM_FEE_BPS=300
# Optional. Default on. Set 0 to hide promotion-code field on Checkout.
# STRIPE_ALLOW_PROMOTION_CODES=1
#
# LIVE price IDs (price_…). Create in Dashboard or:
#   node --experimental-strip-types scripts/stripe-catalog.mjs --create
#   POST /api/admin/stripe-catalog (admin session)
# Then paste the printed IDs here / on Vercel. These are not secret keys.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_NETWORK_MONTHLY=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_YEARLY=
# Optional add-ons
# STRIPE_PRICE_FEATURED_CITY=
# STRIPE_PRICE_CLAIM_BOOST=
# STRIPE_PRICE_JOB_POST=
# Optional Dashboard Payment Links (Checkout Session is preferred)
# STRIPE_PAYMENT_LINK_FEATURED_CITY=
# STRIPE_PAYMENT_LINK_CLAIM_BOOST=
# STRIPE_PAYMENT_LINK_JOB_POST=

# Cloudflare Turnstile (managed widget on login / claim / contact / reset / 2FA).
# Site key is public; secret stays server-only. Production enforces when both
# are set. Preview fails open if keys are missing.
# Allow both kidease.ca and www.kidease.ca on the Turnstile hostnames list.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Sentry error + performance ingest. Server uses SENTRY_DSN (already on
# Vercel Production as a secret). The browser needs the SAME DSN value as a
# public env so Vite can inline it — do not put SENTRY_DSN in the client
# bundle. Leave both unset locally; the app still boots with ingest off.
# SENTRY_DSN=
# VITE_PUBLIC_SENTRY_DSN=

# Cloudflare R2 (private originals, S3 API). Server-only — never prefix VITE_.
# Production bucket is kidease-media (Western North America).
# put/get goes through /api/admin/media (admin session required).
# Listing cards keep /photos/… catalogue paths. /img dual-reads originals/{rel}
# then Git. Public media prefix (optional): see R2_PUBLIC_BASE_URL below.
# One-shot private copy: npm run photos:migrate-r2 -- --apply
# (scripts/r2-photo-migrate.md). Public keys: npm run photos:sync-r2
# (scripts/r2-public-photos.md). Never commit real values.
# R2_ACCOUNT_ID=
# R2_BUCKET=kidease-media
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# Optional. Set to 0 until the migrate finishes so /img stays on Git.
# R2_READ_ORIGINALS=
# Public listing-photo host (not a secret). When set, /photos/… becomes
# ${base}/photos/…. Leave unset to keep same-origin public/photos fallback.
# Set both so SSR and the Vite client agree.
# Production: https://media.kidease.ca (R2 custom domain on kidease-media).
# Optional/dev only: https://*.r2.dev — the pub-*.r2.dev host returns 401.
# R2_PUBLIC_BASE_URL=
# VITE_R2_PUBLIC_BASE_URL=
# Cloudflare Image Transformations on media.kidease.ca (not a second store).
# Leave unset / 0 until Kyle enables Transformations in the Cloudflare
# dashboard for the kidease.ca zone. Then set both to 1 and redeploy so
# Vite inlines the client flag. Absent env = original R2 URLs.
# No API token. Do not upload to Cloudflare Images. See docs/image-resizing.md.
# CF_IMAGE_RESIZE=
# VITE_CF_IMAGE_RESIZE=

# PostHog product analytics (client). The project API key is public-by-design
# (same class as a web pixel). Do not commit real values. Production already
# has these on Vercel. Leave unset locally to disable capture.
# App boots if the key is missing. See docs/posthog.md.
# VITE_PUBLIC_POSTHOG_KEY=
# POSTHOG_HOST=https://us.i.posthog.com
# Optional client override if POSTHOG_HOST is not inlined at build time:
# VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Web session replay (privacy-masked). On when the public key is set.
# Sample is 0–1 (default 0.2) so recording cost stays bounded.
# Set VITE_PUBLIC_POSTHOG_REPLAY=0 to stop recordings without removing analytics.
# Capacitor stays off unless VITE_PUBLIC_POSTHOG_REPLAY_NATIVE=1.
# Remote kill switch: PostHog flag `session-replay-web` (off = stop). See docs/posthog.md.
# VITE_PUBLIC_POSTHOG_REPLAY=1
# VITE_PUBLIC_POSTHOG_REPLAY_SAMPLE=0.2
# VITE_PUBLIC_POSTHOG_REPLAY_NATIVE=0
# Optional server overlay for FEATURE_* (same public project API key as above).
# Leave unset to keep today’s env-only flags. See docs/flags.md.
# Do not invent a personal API key. App boots with this blank.
# POSTHOG_FLAGS_KEY=
# POSTHOG_FLAGS_HOST=

# In-app chat scaffold (admin /admin-chat only). Off until a real build.
# Existing /inbox (booking-tied conversations) stays the live messages UI.
# FEATURE_INAPP_CHAT=0

# Provider desk Subscription tab (daycare SaaS: Free / Pro / Network).
# LIVE by default when unset. Directors see Free / Pro / Network.
# Set 0 only to hide the tab from directors (admin can still preview).
# Checkout charges only with sk_live_ plus the STRIPE_PRICE_* IDs above.
FEATURE_PROVIDER_SUBSCRIPTIONS=1

# Capacitor native shell (TestFlight / Play internal). Production default is
# https://www.kidease.ca — do not point store binaries at preview hosts.
# Override only for on-device live reload against a laptop/dev server.
# CAP_SERVER_URL=

# Public store listing IDs for write-review deep links. Not secrets.
# Apple: numeric App Store Connect id only (apps.apple.com/app/idNNNN). Leave
# blank until assigned — do not invent. Play package defaults to the Capacitor
# appId ca.daycarenearme.app.
# VITE_APPLE_APP_STORE_ID=
# VITE_PLAY_PACKAGE_NAME=

# Store universal / app links (AASA + Digital Asset Links).
# Served at /.well-known/apple-app-site-association and /.well-known/assetlinks.json
# as application/json. Bundle id is already ca.daycarenearme.app.
# Do not invent a Team ID or Play signing SHA-256. Leave blank until enrolled.
# Missing Team ID → documented placeholder XXXXXXXXXX in the AASA JSON.
# Missing fingerprints → empty sha256_cert_fingerprints array.
# APPLE_TEAM_ID=
# ANDROID_SHA256_CERT_FINGERPRINTS=
# Comma-separated Play App Signing (+ upload) cert SHA-256, colon hex
# (Play Console → App integrity → App signing). Same Team ID as APNS_TEAM_ID.

# Push scaffold (FCM / APNs). Off on www and in this repo. Do not invent keys.
# Capacitor PushNotifications is wired for a later native build — FEATURE_PUSH
# must be 1 AND a TestFlight / Play binary must include the plugin before any
# device prompts. Absent Vercel env = off. See docs/push.md.
FEATURE_PUSH=0
# Transactional email (password reset, 2FA, claims, contact, search alerts).
# Same path as other KidEase mail: Resend first, then SendGrid. Password reset
# does not invent delivery — without one of these keys the form shows an error.
# RESEND_API_KEY=
# SENDGRID_API_KEY=
# MAIL_FROM=KidEase <kyle@kidease.ca>

# Inngest (durable background jobs). Server-only — never prefix VITE_.
# Paste keys from Inngest Cloud (or the Vercel integration) into project
# kidease-git, Production + Preview. Do not invent values. App boots if unset.
# Serve route is TanStack Start /api/inngest (not a Next.js app/api path).
# See docs/inngest.md.
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=
# Optional. Production custom domain so Cloud syncs www instead of *.vercel.app.
# INNGEST_SERVE_ORIGIN=https://www.kidease.ca

# Saved-search alert cron (/api/search-alerts) reuses CRON_SECRET / DIGEST_SECRET.
# Vercel Cron sends Authorization: Bearer $CRON_SECRET. Query ?secret= is rejected.
# When both INNGEST_* keys are set, Inngest owns the hourly schedule and this
# HTTP cron no-ops (use ?force=1 or ?dryRun=1 to run locally). See docs/inngest.md.
# Email uses RESEND_API_KEY when set; otherwise the job stubs and logs.
# CRON_SECRET=
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY=
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=ca.daycarenearme.app
# APNS_KEY=
# TestFlight / App Store use production APNs. Leave 0 until a signed native build exists.
# APNS_PRODUCTION=0
# VITE_FCM_VAPID_PUBLIC_KEY=

# Twilio transactional SMS (Canada). Off. Do not invent credentials.
# Prefer a Canadian sender or Messaging Service (MG…). Auth token OR API key.
# Webhook signature validation still needs TWILIO_AUTH_TOKEN (not the API key secret).
# CASL consent + STOP apply before FEATURE_SMS=1. CRTC carrier registration is Dashboard ops later.
# See docs/sms.md. Never commit real SID/token/secret values.
# Leave FEATURE_SMS=0 until consent capture is live and a Canadian sender exists.
FEATURE_SMS=0
TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_API_KEY_SID=
# TWILIO_API_KEY_SECRET=
# TWILIO_FROM_NUMBER=
# TWILIO_MESSAGING_SERVICE_SID=
# TWILIO_STATUS_CALLBACK_URL=
# TWILIO_INBOUND_CALLBACK_URL=

# Twilio Video (parent ↔ centre tour). Off. Parent Plus gated.
# Reuse TWILIO_ACCOUNT_SID above. Access Tokens need an API key (SK… + secret),
# not the Auth Token. Optional room status callback. No recording in v1.
# See docs/video.md. Never commit real SID/token/secret values.
FEATURE_VIDEO=0
# TWILIO_VIDEO_STATUS_CALLBACK_URL=

# DocuSign eSignature (Admin → Contracts). Server-only — never prefix VITE_.
# Leave blank to keep Send disabled. JWT Grant (integration key + user + RSA key).
# Never commit the PEM, webhook HMAC, or passwords. See docs/docusign.md.
# DOCUSIGN_INTEGRATION_KEY=
# DOCUSIGN_USER_ID=
# DOCUSIGN_ACCOUNT_ID=
# DOCUSIGN_PRIVATE_KEY=
# DOCUSIGN_ENV=demo
# DOCUSIGN_AUTH_BASE=
# DOCUSIGN_BASE_URI=
# DOCUSIGN_WEBHOOK_SECRET=
# DOCUSIGN_TEMPLATE_PROVIDER_AGREEMENT=
# DOCUSIGN_TEMPLATE_ENROLMENT_PACK=
# DOCUSIGN_TEMPLATE_ROLE=Provider
# APP_ORIGIN=https://www.kidease.ca

# Better Stack Uptime (on-call). HTTP monitors live in the Better Stack
# dashboard — they GET https://www.kidease.ca/ and /api/health. The app
# boots with these unset. Never prefix VITE_. Never commit real values.
# Alert mailbox: kyle@kidease.ca (email first). SMS / Slack later — docs/uptime.md.
# BETTERSTACK_HEARTBEAT_URL=
# Dashboard-only. Not read by the app. Paste in Better Stack if you use their API.
# BETTERSTACK_UPTIME_API_TOKEN=
