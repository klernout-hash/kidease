# Production (Vercel) — server env only. Never prefix these with VITE_.
# Never commit real values. Set the same keys in the Vercel project
# (Production + Preview) as encrypted environment variables.
# Canonical store: 1Password Environments (KidEase Production / Preview).
# Names-only map + Kyle checklist: docs/1password-environments.md
#   npm run ops:1password-checklist

# Neon Postgres (same key on Production + Preview). Leave commented here.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
#
# Licensed listings: Neon is SoT once public daycares >= 10000 (auto).
# CATALOG_SOURCE=auto
# CATALOG_SOURCE=neon
# CATALOG_SOURCE=json
# NEON_CATALOG_MIN_COUNT=10000
# Seed QA ghost / TEST fixtures into Neon. Default on for local + Vercel Preview;
# off for Vercel Production and NODE_ENV=production. Public Explore never shows
# them either way (query filter). Set 1 only on Preview/local claim-lab.
# ALLOW_TEST_LISTINGS=0
# Optional offline blank-only contact fill. Never commit the master CSV.
# MASTER_CSV_PATH=

# Required: session signing across serverless instances. Mint with
# `openssl rand -hex 32` and paste into Vercel — do not put the value here.
# Better Auth reads BETTER_AUTH_SECRET only (not AUTH_SECRET).
# Rotating it drops sessions, not password hashes on account.password.
BETTER_AUTH_SECRET=

# Optional. Routine Admin desk edits (Straighten photo) skip password step-up
# for this many milliseconds after one successful confirm. Default 1200000
# (20 minutes) when unset. High-stakes actions stay on the 10-minute window
# in src/lib/reauth.ts (REAUTH_WINDOW_MS). Not a secret. Safe to leave unset.
# ADMIN_REAUTH_GRACE_MS=1200000

# One-shot operator password (kyle@kidease.ca / ADMIN_EMAIL). Server env only.
# Set on Vercel Production, redeploy, sign in on www, then delete the var.
# Never prefix with VITE_. Never commit a value.
# OPERATOR_RESET_EMAIL=kyle@kidease.ca
# OPERATOR_RESET_PASSWORD=

# App Store / Play reviewer demo (one parent, one daycare). Server env only.
# Run: npm run ops:reviewer-demo
# The same password signs in both accounts. The demo centre is hidden from
# public search. Never commit the password.
# REVIEWER_PARENT_EMAIL=reviewer.parent@kidease.ca
# REVIEWER_DAYCARE_EMAIL=reviewer.daycare@kidease.ca
# REVIEWER_ACCOUNT_PASSWORD=

# Native Sign in with Google (Better Auth socialProviders.google).
# Callback path (already registered on the GCP KidEase web client):
#   https://kidease.ca/api/auth/callback/google
#   https://www.kidease.ca/api/auth/callback/google
#   https://kidease-git.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Native Sign in with Facebook (Better Auth socialProviders.facebook).
# Facebook App ID → FACEBOOK_CLIENT_ID, App Secret → FACEBOOK_CLIENT_SECRET.
# Valid OAuth Redirect URIs on the Meta app (exact, no trailing slash):
#   https://kidease.ca/api/auth/callback/facebook
#   https://www.kidease.ca/api/auth/callback/facebook
#   https://kidease-git.vercel.app/api/auth/callback/facebook
# The redirect_uri is chosen from the request host. Other hosts, including
# random *.vercel.app previews, hide Continue with Facebook.
# Scopes are only email and public_profile (FACEBOOK_LOGIN_SCOPES).
# Permissions: https://developers.facebook.com/docs/facebook-login/permissions
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Continue with Facebook on /login. Default off — the Meta app is parked
# ("App not active") until Live review. Credentials can stay set.
# Flip to 1 after Meta marks the app Live. Not a PostHog product flag.
FEATURE_FACEBOOK_LOGIN=0

# Store sign-in. Default off. Not PostHog product flags.
# Huawei ID (HMS Account Kit) on the AppGallery build. Callback:
#   https://www.kidease.ca/api/auth/callback/huawei
#   https://kidease.ca/api/auth/callback/huawei
#   https://kidease-git.vercel.app/api/auth/callback/huawei
# HUAWEI_APP_ID is the AppGallery Connect app id. HUAWEI_CLIENT_ID is the same value.
# HUAWEI_APP_SECRET is the app secret. Never commit a real secret.
FEATURE_SIGNIN_HUAWEI=0
# HUAWEI_APP_ID=
# HUAWEI_APP_SECRET=
# HUAWEI_CLIENT_ID=
# HUAWEI_CLIENT_SECRET=
# Login with Amazon on the Amazon Appstore / Fire build. Callback:
#   https://www.kidease.ca/api/auth/callback/amazon
#   https://kidease.ca/api/auth/callback/amazon
#   https://kidease-git.vercel.app/api/auth/callback/amazon
# AMAZON_CLIENT_ID and AMAZON_CLIENT_SECRET come from the security profile.
# AMAZON_API_KEY is the API key for package ca.kidease.app. The website
# exchange uses the client id and secret. Do not commit the key.
FEATURE_SIGNIN_AMAZON=0
# AMAZON_CLIENT_ID=
# AMAZON_CLIENT_SECRET=
# AMAZON_API_KEY=
# Optional store for a store-specific web build. Leave blank on www.kidease.ca.
# play | samsung | huawei | amazon | microsoft | ios | web
# The Android product flavor user agent wins when both are set.
# VITE_STORE_CHANNEL=

# Maps use OpenFreeMap (OpenStreetMap) and EOX satellite tiles. No API key.
# Address search that is not already a known city uses the public Photon
# server (cached, rate limited). Do not add a Google Maps browser key.

# Optional public origin override. Dynamic baseURL already allows kidease.ca.
# BETTER_AUTH_URL=https://kidease.ca

# Grok auth broker — keep these on Grok live preview / grok.me only.
# Do not set the preview client on Vercel; production uses native Google / Facebook above.
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=
# GROK_AUTH_ISSUER=https://auth.grok.me

# Support desk (/support*). profiles.role = support | support_lead | admin.
# Case inbox is support@kidease.ca (refunds are a billing case type, not refund@).
# Cloudflare Access already guards /admin*; add /support* on www later (docs/support.md).
# Agents: live refunds capped by this (cents). support_lead and admin are unlimited.
# SUPPORT_REFUND_MAX_CENTS=10000
# Promote staff by role — do not invent a second auth table:
#   update profiles set role = 'support' where user_id = '…';
#   update profiles set role = 'support_lead' where user_id = '…';

# /admin is gated on kyle@kidease.ca only (isKidEaseOperatorEmail).
# ADMIN_EMAIL is accepted only when it is kyle@kidease.ca — other @kidease.ca
# values are ignored. SQL `profiles.role = 'admin'` on a non-kyle mailbox
# does not grant Admin. Support staff stay SQL-promoted (not Admin):
#   update profiles set role = 'support' where user_id = '…';
# ADMIN_EMAIL=kyle@kidease.ca

# Admin → Mail (Titan for kyle@kidease.ca). Production already has TITAN_APP_PASSWORD.
# Use a Titan app password (not the account password) when 2FA is on.
# Username is the mailbox email (TITAN_USER / ADMIN_EMAIL). Never commit the value.
# Hosts default to Titan: IMAP imap.titan.email:993 SSL, SMTP smtp.titan.email:465 SSL
# (or TITAN_SMTP_PORT=587 for STARTTLS).
# TITAN_APP_PASSWORD=
# TITAN_USER=kyle@kidease.ca
# TITAN_IMAP_HOST=imap.titan.email
# TITAN_IMAP_PORT=993
# TITAN_SMTP_HOST=smtp.titan.email
# TITAN_SMTP_PORT=465
# Titan SMTP From MUST be the mailbox (kyle@kidease.ca / TITAN_USER). Do not
# send OTP or Admin Mail via Titan as noreply@send.kidease.ca — Resend's send
# host is not a Titan identity. Apex SPF stays Titan-only. Do not add Resend
# includes on @ / kidease.ca.
# Aliases also accepted: TITAN_PASSWORD / IMAP_PASSWORD, IMAP_USER, IMAP_HOST, SMTP_HOST.
# Keep TITAN_APP_PASSWORD set on Vercel (kidease-git Production). Admin 2FA OTP
# falls back to this SMTP when Resend rejects send.kidease.ca (403 / domain
# not verified).

# Stripe (add when you are ready to take live parent payments and daycare payouts).
# Leave blank (or use sk_test_) to keep the KidEase ledger as
# "Internal ledger (not charged)". Only sk_live_ keys turn charges on.
# Do not mix test and live. Never commit real secret values.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Preview only. Signing secret for the Stripe test-mode webhook
# (events with livemode false). Live events keep STRIPE_WEBHOOK_SECRET.
# Leave blank to fall back to STRIPE_WEBHOOK_SECRET. Never commit a real value.
STRIPE_WEBHOOK_SECRET_TEST=
# Bank payouts to centres. Leave unset (fail closed) while Stripe is
# In review or payouts are paused. Set 1 only after payouts actually clear.
# Marketing copy that says centres are paid quickly stays gated on this.
# STRIPE_PAYOUTS_LIVE=0
# Optional. Paste Stripe’s Apple Pay domain-association file (plain text)
# AFTER account verification: Dashboard → Settings → Payment methods →
# Apple Pay → Add domain www.kidease.ca (and kidease.ca if used). Hosted
# Checkout already shows Apple Pay on checkout.stripe.com without this.
# Unset → /.well-known/apple-developer-merchantid-domain-association is 404.
# Do not invent the file. This is not a secret key.
# APPLE_PAY_DOMAIN_ASSOCIATION=
# STRIPE_APPLE_PAY_DOMAIN_ASSOCIATION=
STRIPE_CONNECT_CLIENT_ID=
# Parent-to-daycare payments. Off until Kyle says.
# Test keys work when this is on. sk_live_ / pk_live_ also need KIDEASE_CONNECT_LIVE=1.
# KIDEASE_CONNECT_PAYMENTS=
# KIDEASE_CONNECT_LIVE=
# STRIPE_CONNECT_WEBHOOK_SECRET=
# APPLE_MERCHANT_ID=
# GOOGLE_PAY_MERCHANT_ID=
# KidEase share of each parent invoice, in basis points. 200 = 2%.
# application_fee_amount is exactly this rate. GST/HST/PST/QST is never added to it.
# Daycares pay Stripe processing fees. The older internal ledger still assumes
# 300 in code when this line is removed.
KIDEASE_PLATFORM_FEE_BPS=200
# Tax on that 2% fee is a separate monthly invoice to the daycare.
# The rate follows that daycare's province. Pick one method, or leave both unset to skip tax.
#   STRIPE_AUTOMATIC_TAX=1           Stripe Tax (extra Stripe fee). Uses the daycare province.
#   KIDEASE_FEE_TAX_MODE=province    Built-in GST/HST/PST/QST table. Needs accountant sign-off.
# If the province is missing, KIDEASE_FEE_TAX_BPS is the fallback. A txr_ id is the flat manual rate.
# STRIPE_FEE_TAX_RATE_ID=
# KIDEASE_FEE_TAX_BPS=
# STRIPE_AUTOMATIC_TAX=
# KIDEASE_FEE_TAX_MODE=
# Optional. Default on. Set 0 to hide promotion-code field on Checkout.
# STRIPE_ALLOW_PROMOTION_CODES=1
#
# LIVE price IDs (price_…). Create in Dashboard or:
#   node --experimental-strip-types scripts/stripe-catalog.mjs --create
#   POST /api/admin/stripe-catalog (admin session)
# Then paste the printed IDs here / on Vercel. These are not secret keys.
#
# These MUST be Stripe recurring prices (type=recurring):
#   STRIPE_PRICE_PRO_MONTHLY          month, $49 CAD
#   STRIPE_PRICE_PRO_YEARLY           year, $490 CAD
#   STRIPE_PRICE_NETWORK_MONTHLY      month, $39 CAD per site
#   STRIPE_PRICE_PLUS_MONTHLY         month, $7.99 CAD
#   STRIPE_PRICE_PLUS_YEARLY          year, $59 CAD
# Proposals — leave unset until Kyle approves the amount and creates the Stripe price.
# The tier stays hidden, and Check prices will not create these:
#   STRIPE_PRICE_NETWORK_YEARLY           year, $390 CAD per site (3-site minimum)
#   STRIPE_PRICE_PARENT_ALERTS_MONTHLY    month, $14.99 CAD
#   STRIPE_PRICE_PARENT_ALERTS_YEARLY     year, $149 CAD
#   STRIPE_PRICE_FEATURED_CITY        month, $29 CAD — a one-time price is rejected
# These MUST be Stripe one-time prices (type=one_time). Checkout uses payment mode, not subscription:
#   STRIPE_PRICE_CLAIM_BOOST          $99 CAD once
#   STRIPE_PRICE_JOB_POST             $49 CAD once
# Admin → Money → Check prices flags a recurring vs one-time mismatch.
# Checkout does not start, and nothing is charged, until the price type matches.
#
# Production notes (Sep 26, 2026). IDs stay in Vercel. Leave the values below empty in git.
# Live and active, recurring:
#   STRIPE_PRICE_PRO_MONTHLY      price_1UCNCUJPTToTeGhamI84tq2r   CA$49 / month
#   STRIPE_PRICE_PRO_YEARLY       price_1UCNCXJPTToTeGhaEVl7LT8N   CA$490 / year
#   STRIPE_PRICE_NETWORK_MONTHLY  price_1UCNCVJPTToTeGhaalZExOy2   CA$39 / site / month
# Network yearly and Parent Alerts are proposals. Do not invent price IDs for them.
# Admin Pro checkout from /provider/subscription opened a cs_live_ session for KidEase Provider Pro at CA$49/month.
# Featured city: set STRIPE_PRICE_FEATURED_CITY to the new recurring price
#   price_1UK11oJPTToTeGhaV6egkrkm (CA$29 / month).
# The old Featured city price price_1UCNCXJPTToTeGhadOK4FpZK is one-time and checkout refuses it.
# Claim boost and Job post are one-time. The catalog starts those two in payment mode.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_NETWORK_MONTHLY=
# STRIPE_PRICE_NETWORK_YEARLY=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_YEARLY=
# STRIPE_PRICE_PARENT_ALERTS_MONTHLY=
# STRIPE_PRICE_PARENT_ALERTS_YEARLY=
# Optional add-ons. Featured city is recurring monthly. Claim boost and Job post are one-time.
# STRIPE_PRICE_FEATURED_CITY=
# STRIPE_PRICE_CLAIM_BOOST=
# STRIPE_PRICE_JOB_POST=
# Payment Links are not used for checkout. Checkout Sessions validate the price type.
# STRIPE_PAYMENT_LINK_FEATURED_CITY=
# STRIPE_PAYMENT_LINK_CLAIM_BOOST=
# STRIPE_PAYMENT_LINK_JOB_POST=
# Customer Portal configurations (bpc_…). Create two in live mode. Cancellation
# at period end, not immediately. Parent config: Parent Plus and Parent Alerts
# only, monthly and yearly in one switch group. Daycare config: Pro and Network
# in one switch group (Network quantity per site, minimum 3), plus Featured city
# as its own product that can cancel at period end and is not switched with Pro.
# Claim boost and Job post are one-time and stay out of the portal.
# STRIPE_BILLING_PORTAL_PARENT=
# STRIPE_BILLING_PORTAL_DAYCARE=

# Cloudflare Turnstile (visible managed / checkbox widget on every password
# login, sign-up, forgot/reset, 2FA, and reauth). Site key is public; secret
# stays server-only. Production enforces when both are set. Preview fails
# open if keys are missing. Do not invent a second native site key —
# Capacitor loads https://www.kidease.ca. Allow both kidease.ca and
# www.kidease.ca on the Turnstile hostnames list.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Sentry error + performance ingest. Server uses SENTRY_DSN (already on
# Vercel Production as a secret). The browser needs the SAME DSN value as a
# public env so Vite can inline it — do not put SENTRY_DSN in the client
# bundle. Leave both unset locally; the app still boots with ingest off.
# SENTRY_DSN=
# VITE_PUBLIC_SENTRY_DSN=
# Auth token for the account hard-wipe to delete the Sentry user.
# Org and project are read from the DSN when these two are unset.
# The wipe still finishes when the token is missing.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# Cloudflare R2 (private originals, S3 API). Server-only — never prefix VITE_.
# Production bucket is kidease-media (Western North America).
# Required on Production for provider screening PDFs and licence scans
# (keys under screening/ and licenses/ — private, not media.kidease.ca).
# Local/dev can store tiny files as data URLs; real PDFs need R2 or upload fails
# with the setup message. put/get for listing originals also uses these keys.
# Screening/licence view goes through /api/screening-documents and /api/license-docs.
# Admin media put/get goes through /api/admin/media (admin session required).
# Listing cards keep /photos/… catalogue paths. /img dual-reads originals/{rel}
# then Git. Public media prefix (optional): see R2_PUBLIC_BASE_URL below.
# One-shot private copy: npm run photos:migrate-r2 -- --apply
# (scripts/r2-photo-migrate.md). Public keys: npm run photos:sync-r2
# (scripts/r2-public-photos.md). Never commit real values.
# R2_ACCOUNT_ID=
# R2_BUCKET=kidease-media
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# Optional. Set to 0 until the migrate finishes so /img stays on Git.
# R2_READ_ORIGINALS=
# Public listing-photo host (not a secret). When set, /photos/… becomes
# ${base}/photos/…. Leave unset to keep same-origin public/photos fallback.
# Set both so SSR and the Vite client agree.
# Production: https://media.kidease.ca (R2 custom domain on kidease-media).
# Optional/dev only: https://*.r2.dev — the pub-*.r2.dev host returns 401.
# R2_PUBLIC_BASE_URL=
# VITE_R2_PUBLIC_BASE_URL=
# Cloudflare Image Transformations on media.kidease.ca (not a second store).
# Leave unset / 0 until Kyle enables Transformations in the Cloudflare
# dashboard for the kidease.ca zone. Then set both to 1 and redeploy so
# Vite inlines the client flag. Absent env = same-origin /img (AVIF/WebP)
# with the original media.kidease.ca/photos/… URL as onError fallback.
# No API token. Do not upload to Cloudflare Images. See docs/image-resizing.md.
# CF_IMAGE_RESIZE=
# VITE_CF_IMAGE_RESIZE=
# Optional upload polish. Leave both unset: daycare and Admin listing photos
# still straighten, sharpen, and frame on the server with sharp (no network).
# Set both to ask an HTTPS vision endpoint for angleDeg + a fractional crop
# before that pass. A failed call keeps the deterministic result. Never VITE_.
# Only the image the centre uploaded is sent. See docs/listing-photo-polish.md.
# LISTING_PHOTO_VISION_URL=
# LISTING_PHOTO_VISION_KEY=

# PostHog product analytics (client). The project API key is public-by-design
# (same class as a web pixel). Do not commit real values. Production already
# has these on Vercel. Leave unset locally to disable capture.
# App boots if the key is missing. See docs/posthog.md.
# VITE_PUBLIC_POSTHOG_KEY=
# POSTHOG_HOST=https://us.i.posthog.com
# Browser uses first-party /ingest (see docs/posthog.md). Leave this unset
# unless you need a non-US / managed proxy. A default US host is ignored.
# VITE_PUBLIC_POSTHOG_HOST=
# Web session replay (privacy-masked). On when the public key is set.
# Sample is 0–1 (default 0.2) so recording cost stays bounded.
# Set VITE_PUBLIC_POSTHOG_REPLAY=0 to stop recordings without removing analytics.
# Capacitor stays off unless VITE_PUBLIC_POSTHOG_REPLAY_NATIVE=1.
# Remote kill switch: PostHog flag `session-replay-web` (off = stop). See docs/posthog.md.
# VITE_PUBLIC_POSTHOG_REPLAY=1
# VITE_PUBLIC_POSTHOG_REPLAY_SAMPLE=0.2
# VITE_PUBLIC_POSTHOG_REPLAY_NATIVE=0
# Optional server overlay for FEATURE_* (same public project API key as above).
# Leave unset to keep today’s env-only flags. See docs/flags.md.
# Do not invent a personal API key. App boots with this blank.
# POSTHOG_FLAGS_KEY=
# POSTHOG_FLAGS_HOST=

# In-app chat scaffold (admin /admin-chat only). Off until a real build.
# Existing /inbox (booking-tied conversations) stays the live messages UI.
# Composer on /admin-chat stays disabled even if this is flipped. See docs/chat.md.
FEATURE_INAPP_CHAT=0

# Provider desk Subscription tab (daycare SaaS: Free / Pro / Network).
# LIVE by default when unset. Directors see Free / Pro / Network.
# Set 0 only to hide the tab from directors (admin can still preview).
FEATURE_PROVIDER_SUBSCRIPTIONS=1

# Parent / director Upgrade · Subscribe · plan-price chrome.
# Default OFF. Stripe, webhooks, and plan tables stay. Set 1 to restore CTAs
# after SUBSCRIPTIONS_ENABLED=1. Admin Stripe catalog stays available either way.
SHOW_PAY_CTAS=0

# Paid plans and checkout. Default OFF: free founding period, no charges,
# daycare tools unlocked, /plans explains Free during launch.
# Set 1 to restore the current subscription flow. Does not invent a price.
# PostHog flag with this same name flips it without a redeploy.
SUBSCRIPTIONS_ENABLED=0

# Founding member badge. Default ON. Set 0 to hide the badge.
# The founding_member column stays so a later discount can be honoured.
FOUNDING_BADGE_ENABLED=1

# Email when a saved search matches a newly posted open spot. Default OFF.
# Saving a search still works. Needs CASL. See docs/flags.md.
FEATURE_OPEN_SPOT_ALERTS=0

# Area waitlist email. Default OFF. Kyle approved the wording. Set 1 to send it.
# Joining an area waitlist and the in-app bell still work. Area texts need
# FEATURE_SMS and stored CASL SMS consent. They do not need plus_plan=alerts.
# Saved-search SMS still does. Push stays on FEATURE_PUSH.
FEATURE_AREA_WAITLIST_ALERTS=0

# Automation pack. Every flag defaults off. Setting a flag to 1 is dry-run
# (logs the intended send). Add _LIVE=1 only after a test-account check.
# Do not turn on SUBSCRIPTIONS_ENABLED, SHOW_PAY_CTAS, or in-app purchases.
FEATURE_POSTHOG_ERRORS=0
FEATURE_OPS_ALERTS=0
FEATURE_CRON_HEARTBEATS=0
FEATURE_INVOICE_REMINDERS=0
FEATURE_PAYMENT_DUNNING=0
FEATURE_MISSING_INFO_REMINDERS=0
FEATURE_DAYCARE_ONBOARDING=0
FEATURE_CLAIM_LISTING_REMINDERS=0
FEATURE_STALE_OPEN_SPOTS=0
FEATURE_POST_TOUR_FOLLOWUP=0
FEATURE_ENROLMENT_REVIEW=0
FEATURE_NEON_BACKUP=0
# FEATURE_POSTHOG_ERRORS_LIVE=0
# FEATURE_OPS_ALERTS_LIVE=0
# FEATURE_CRON_HEARTBEATS_LIVE=0
# FEATURE_INVOICE_REMINDERS_LIVE=0
# FEATURE_PAYMENT_DUNNING_LIVE=0
# FEATURE_MISSING_INFO_REMINDERS_LIVE=0
# FEATURE_DAYCARE_ONBOARDING_LIVE=0
# FEATURE_CLAIM_LISTING_REMINDERS_LIVE=0
# FEATURE_STALE_OPEN_SPOTS_LIVE=0
# FEATURE_POST_TOUR_FOLLOWUP_LIVE=0
# FEATURE_ENROLMENT_REVIEW_LIVE=0
# FEATURE_NEON_BACKUP_LIVE=0
# Limit live mail to these addresses while you test. Unset sends to everyone
# once the matching _LIVE flag is on. Ops mail to kyle@kidease.ca is exempt.
# AUTOMATION_TEST_EMAILS=
# CLAIM_REMINDER_DAILY_CAP=25
# One Better Stack heartbeat URL per cron. Only https://uptime.betterstack.com
# or https://betteruptime.com. Leave unset until the monitor exists.
# BETTERSTACK_HEARTBEAT_OPS_ALERTS=
# BETTERSTACK_HEARTBEAT_INVOICE_REMINDERS=
# BETTERSTACK_HEARTBEAT_LISTING_REMINDERS=
# BETTERSTACK_HEARTBEAT_STALE_OPEN_SPOTS=
# BETTERSTACK_HEARTBEAT_TOUR_FOLLOWUPS=
# BETTERSTACK_HEARTBEAT_NEON_BACKUP=
# BETTERSTACK_HEARTBEAT_DIGEST=
# BETTERSTACK_HEARTBEAT_SEARCH_ALERTS=
# BETTERSTACK_HEARTBEAT_DOCUSIGN_POLL=
# BETTERSTACK_HEARTBEAT_TOUR_HOLDS=
# BETTERSTACK_HEARTBEAT_RANKING_MARKET=
# BETTERSTACK_HEARTBEAT_PROVINCIAL_VACANCY=
# BETTERSTACK_HEARTBEAT_SPOT_OFFERS=
# BETTERSTACK_HEARTBEAT_OPEN_SPOTS_CHECKIN=
# BETTERSTACK_HEARTBEAT_ACCOUNT_PURGE=
# Cached public inspection rows (ON, BC, AB) on a listing. Default OFF.
# A row is shown only when it cites a public government page. KidEase does not invent violations.
FEATURE_INSPECTION_HISTORY=0
# Per-province vacancy index, confirm history, and freshness bands. Default OFF.
# The national /vacancy-index page stays either way. No email or SMS from this flag.
FEATURE_PROVINCIAL_VACANCY_INDEX=0
# Report a published parent review and show a rating from the first review.
# Default OFF. Cards keep the three-review gate until this is on. No email or SMS.
FEATURE_REVIEW_REPORTS=0
# Tour no-show, moved reminders, and a calendar file in the booking email.
# Default OFF. Booking, confirm, and the browser calendar download still work.
FEATURE_TOUR_PIPELINE=0
# Need care fast: more open spots first, then closer. Default OFF.
# Closest-first stays until this is on. OpenStreetMap pins only. No Google Maps.
FEATURE_NEED_CARE_FAST=0
# Diet and extra-support fields on the centre profile. Default OFF.
# Search chips for meals, inclusive, and language stay either way.
FEATURE_INCLUSIVE_FILTERS=0
# ECE roles on a centre profile: post, apply, and see applicants. Default OFF.
# Does not charge. Does not turn subscriptions on.
FEATURE_ECE_JOBS=0
# Door check-in and check-out on /checkin. Default OFF.
# The camera preview stays until this is on. No photo of a child. No SMS.
FEATURE_DIGITAL_ATTENDANCE=0
# Staff shifts, ECE certificate reminders, and room ratios. Default OFF.
# Email only. No SMS. Not payroll and not a subscription.
FEATURE_STAFF_SCHEDULING=0
# Private learning stories for enrolled parents. Default OFF.
# No photos. Not a public listing. Not a subscription.
FEATURE_LEARNING_PORTFOLIOS=0
# Occupancy across the centres you run. Default OFF.
# Shows a percent only when capacity and enrolled bookings are both on file.
FEATURE_ORG_DASHBOARD=0
# Private classroom photos for enrolled parents who consented. Default OFF.
# Never used on public listings or marketing. No email of the photo. No SMS.
FEATURE_PRIVATE_PHOTO_FEED=0
# Government desk footer link. Default off. /gov sign-in still works.
# Does not put the desk in the phone app.
FEATURE_GOV_PORTAL=0

# Demo government account. Server only. Never commit a password or API key.
# Run: npm run ops:gov-demo
# The seed hashes the password and optional API key. It does not print them.
# GOV_DEMO_EMAIL=
# GOV_DEMO_PASSWORD=
# GOV_DEMO_API_KEY=
# Named product events. Default OFF. Set both to 1 to send them.
# Server reads FEATURE_PRODUCT_EVENTS. The browser reads VITE_FEATURE_PRODUCT_EVENTS.
# Properties stay coarse. No name, email, phone, child, or address.
FEATURE_PRODUCT_EVENTS=0
VITE_FEATURE_PRODUCT_EVENTS=0
# Need care fast street matching. Default OFF. Uses OpenStreetMap Nominatim only.
# Do not set a Google Maps key for this.
FEATURE_NCF_STREET=0

# Capacitor native shell (TestFlight / Play internal). Production default is
# https://www.kidease.ca — do not point store binaries at preview hosts.
# Override only for on-device live reload against a laptop/dev server.
# CAP_SERVER_URL=

# Public store listing IDs for write-review deep links. Not secrets.
# Apple numeric id for ca.kidease.app (apps.apple.com/app/id6827660912).
# VITE_APPLE_APP_STORE_ID overrides STORE.appleAppStoreId. Play package
# defaults to the Capacitor appId ca.kidease.app.
VITE_APPLE_APP_STORE_ID=6827660912
# VITE_PLAY_PACKAGE_NAME=
# Public Play listing URL only — leave blank until the listing is live.
# Do not invent a store URL from the package name.
# VITE_PLAY_STORE_URL=

# Store universal / app links (AASA + Digital Asset Links).
# Served at /.well-known/apple-app-site-association, /apple-app-site-association
# (Apple root alias), and /.well-known/assetlinks.json as application/json.
# Bundle id is already ca.kidease.app.
# Do not invent a Play signing SHA-256.
# Team ID GAUC28WJXZ (10037493 MANITOBA LTD.) is the AASA default when APPLE_TEAM_ID is unset.
# Missing fingerprints → the Play App Signing and upload SHA-256 in assetlinks.json.
# Sign in with Apple. Leave blank until the Apple Developer account is approved.
# The button stays hidden until all four APPLE_* values below are set
# AND FEATURE_APPLE_LOGIN=1. Default off. Not a PostHog product flag.
# Enrolment id B7UM5AC9JQ is NOT the Team ID.
FEATURE_APPLE_LOGIN=0
# APPLE_CLIENT_ID=        Services ID, example ca.kidease.web
# APPLE_TEAM_ID=GAUC28WJXZ   10-character Team ID from Membership (10037493 MANITOBA LTD.)
# APPLE_KEY_ID=           10-character Key ID of the Sign in with Apple .p8
# APPLE_PRIVATE_KEY=      PKCS8 .p8 contents, newlines as \n. Never commit the file.
# APPLE_BUNDLE_ID=        optional, default ca.kidease.app
# Return URL: https://www.kidease.ca/api/auth/callback/apple
# Setup: docs/apple-sign-in.md
# APPLE_TEAM_ID=GAUC28WJXZ
# ANDROID_CERT_SHA256S=
# ANDROID_SHA256_CERT_FINGERPRINTS=
# ANDROID_CERT_SHA256S is the name to paste (ANDROID_SHA256_CERT_FINGERPRINTS
# still works). Comma-separated Play App Signing (+ upload) cert SHA-256,
# colon hex (Play Console → App integrity → App signing). Same Team ID as
# APNS_TEAM_ID.

# Push scaffold (FCM / APNs). Off on www and in this repo. Do not invent keys.
# Capacitor PushNotifications is wired for a later native build — FEATURE_PUSH
# must be 1 AND a TestFlight / Play binary must include the plugin before any
# device prompts. Absent Vercel env = off. See docs/push.md.
# Production: leave 0 unless a real secret exists on this environment
# (FCM trio, APNs set, or the VAPID public+private pair). Code default stays off.
# Preview/dev may set 1 to exercise Chat lab; send still no-ops without secrets.
FEATURE_PUSH=0
# Transactional email (password reset, 2FA, claims, contact, search alerts).
# OTP / reset path: Resend first, then SendGrid, then Titan SMTP
# (TITAN_APP_PASSWORD) when Resend fails (403 / send.kidease.ca not verified)
# or when sending to kyle@ / TITAN_USER. Prefer delivering the code. If every
# provider fails, the UI says so — it does not pretend a code was sent.
# Production SHOULD set MAIL_FROM on Vercel project kidease-git (Production):
#   MAIL_FROM=KidEase <noreply@send.kidease.ca>
# Code default is that send subdomain. Leftover MAIL_FROM=kyle@kidease.ca
# is still remapped for *generic* transactional From. OTP does NOT stay
# stuck on a broken send host: after Resend 403/unverified it retries the
# emergency From (below) then Titan SMTP. Reply-To stays ADMIN_EMAIL / kyle@.
# Do NOT add Resend / amazonses.com includes on apex SPF.
# Emergency Resend From — never remapped to send.kidease.ca. Use while
# send.kidease.ca is missing from the Resend dashboard (apex kidease.ca is
# already verified). Titan SMTP From stays kyle@ / TITAN_USER either way.
#   MAIL_FROM_RESEND=KidEase <kyle@kidease.ca>
# Still verify send.kidease.ca in Resend + Squarespace DNS when you can.
# Do not invent RESEND_API_KEY.
# RESEND_API_KEY=
# Bounce / complaint webhook signing secret (Svix, starts with whsec_).
# Unset → POST /api/webhooks/resend no-ops and does not suppress anyone.
# Kyle — Resend dashboard → Webhooks → Add endpoint:
#   URL: https://www.kidease.ca/api/webhooks/resend
#   Events: email.bounced, email.complained, email.delivered,
#     email.delivery_delayed, email.suppressed, suppression.added,
#     suppression.removed
# Paste the signing secret on Vercel (Production + Preview) as
# RESEND_WEBHOOK_SECRET. Never prefix VITE_. Never commit the value.
# See docs/email-suppressions.md.
# RESEND_WEBHOOK_SECRET=
# SENDGRID_API_KEY=
# MAIL_FROM=KidEase <noreply@send.kidease.ca>
# MAIL_FROM_RESEND=KidEase <kyle@kidease.ca>

# Inngest (durable background jobs). Server-only — never prefix VITE_.
# Paste keys from Inngest Cloud (or the Vercel integration) into project
# kidease-git, Production + Preview. Do not invent values. App boots if unset.
# Serve route is TanStack Start /api/inngest (not a Next.js app/api path).
# See docs/inngest.md.
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=
# Optional. Production custom domain so Cloud syncs www instead of *.vercel.app.
# INNGEST_SERVE_ORIGIN=https://www.kidease.ca

# Saved-search alert cron (/api/search-alerts) reuses CRON_SECRET / DIGEST_SECRET.
# Vercel Cron sends Authorization: Bearer $CRON_SECRET. Query ?secret= is rejected.
# When both INNGEST_* keys are set, Inngest owns the hourly schedule and this
# HTTP cron no-ops (use ?force=1 or ?dryRun=1 to run locally). See docs/inngest.md.
# Email uses RESEND_API_KEY when set; otherwise the job stubs and logs.
# CRON_SECRET=
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY=
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=ca.kidease.app
# APNS_KEY=
# TestFlight / App Store use production APNs. Leave 0 until a signed native build exists.
# APNS_PRODUCTION=0
# Website Web Push. Same public key in both names. Private key is server-only.
# Generate locally (do not commit the output). See docs/push.md.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@kidease.ca
# VITE_FCM_VAPID_PUBLIC_KEY=

# Twilio transactional SMS (Canada). Off. Do not invent credentials.
# Prefer a Canadian sender or Messaging Service (MG…). Auth token OR API key.
# Webhook signature validation still needs TWILIO_AUTH_TOKEN (not the API key secret).
# CASL consent + STOP apply before FEATURE_SMS=1. CRTC carrier registration is Dashboard ops later.
# See docs/sms.md. Never commit real SID/token/secret values.
# Leave FEATURE_SMS=0 until consent capture is live and a Canadian sender exists.
# Production: leave 0 unless Twilio send credentials exist on this environment.
# Preview/dev may set 1 to exercise consent UI; send still no-ops without secrets.
FEATURE_SMS=0
# Email when a daycare offers a waitlist spot. Default off. The offer still shows in the parent account.
FEATURE_SPOT_OFFER_MAIL=0
# Weekly open-spots check-in. Both default off. Mail sends only when MAIL is 1.
# SMS also needs FEATURE_SMS, CASL consent, and an approved toll-free sender.
FEATURE_OPEN_SPOTS_CHECKIN_MAIL=0
FEATURE_OPEN_SPOTS_CHECKIN_SMS=0
# Quebec recognized home daycares (milieux familiaux reconnus). Default off.
# No email or SMS to those providers. Leave 0 until Kyle publishes the list.
FEATURE_QC_HOME_DAYCARES=0
TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# Optional second token only while rotating. Leave unset. A bad token shows up
# as HTTP 401 on /api/sms/inbound or /api/sms/status, not as a missing webhook.
# TWILIO_AUTH_TOKEN_NEXT=
# TWILIO_API_KEY_SID=
# TWILIO_API_KEY_SECRET=
# TWILIO_FROM_NUMBER=
# Approved toll-free sender. Same number as voice. Prefer the Messaging Service for SMS.
# TWILIO_PHONE_NUMBER=
# TWILIO_MESSAGING_SERVICE_SID=
# TWILIO_STATUS_CALLBACK_URL=
# TWILIO_INBOUND_CALLBACK_URL=

# Twilio Video (parent ↔ centre tour). Off. Parent Plus gated.
# Reuse TWILIO_ACCOUNT_SID above. Access Tokens need an API key (SK… + secret),
# not the Auth Token. Optional room status callback. No recording in v1.
# See docs/video.md. Never commit real SID/token/secret values.
# Production: leave 0 unless the Video API key exists on this environment.
# Preview/dev may set 1 to mint a lab token. Inbox Video stays hidden until
# VIDEO_SDK_WIRED is true.
FEATURE_VIDEO=0
# TWILIO_VIDEO_STATUS_CALLBACK_URL=

# Twilio Voice. Browser calls between a parent and a daycare. Numbers stay hidden.
# Reuse the Account SID, Auth Token, and API key above.
# Create a TwiML App whose Voice request URL is https://www.kidease.ca/api/voice/connect
# Set the toll-free number's voice webhook to https://www.kidease.ca/api/voice/incoming
# TWILIO_TWIML_APP_SID=
# TWILIO_VOICE_INCOMING_URL=
# TWILIO_VOICE_CONNECT_URL=
# TWILIO_VOICE_RECORDING_URL=

# DocuSign eSignature (Admin → Contracts). Server-only — never prefix VITE_.
# Leave blank to keep Send disabled. JWT Grant (integration key + user + RSA key).
# Never commit the PEM, webhook HMAC, or passwords. See docs/docusign.md.
# DOCUSIGN_INTEGRATION_KEY=
# DOCUSIGN_USER_ID=
# DOCUSIGN_ACCOUNT_ID=
# DOCUSIGN_PRIVATE_KEY=
# DOCUSIGN_ENV=demo
# DOCUSIGN_AUTH_BASE=
# DOCUSIGN_BASE_URI=
# DOCUSIGN_WEBHOOK_SECRET=
# Optional extra Connect HMAC keys, comma-separated, for key rotation.
# DOCUSIGN_WEBHOOK_SECRETS=
# Optional extra account ids, comma-separated. Any other account is ignored
# with HTTP 200 and is not written. Leave unset to accept only DOCUSIGN_ACCOUNT_ID.
# DOCUSIGN_CONNECT_ACCOUNT_IDS=
# DOCUSIGN_TEMPLATE_PROVIDER_AGREEMENT=
# DOCUSIGN_TEMPLATE_ENROLMENT_PACK=
# DOCUSIGN_TEMPLATE_ROLE=Provider
# Optional eSignature brandId for this account. Production: KidEase sub-account
# brand. Leave unset to keep the account default brand. Placeholder only — do
# not paste a real GUID here.
# DOCUSIGN_BRAND_ID=
# APP_ORIGIN=https://www.kidease.ca

# Better Stack Uptime (on-call). HTTP monitors live in the Better Stack
# dashboard — they GET https://www.kidease.ca/ and /api/health. Keyword
# monitor `cfr_candidate` pages when /api/health cfr.candidate is true.
# Healthy probes ping BETTERSTACK_HEARTBEAT_URL when set. The app
# boots with these unset. Never prefix VITE_. Never commit real values.
# Alert mailbox: kyle@kidease.ca (email first). SMS / Slack later — docs/uptime.md.
# BETTERSTACK_HEARTBEAT_URL=
# Dashboard-only. Not read by the app. Paste in Better Stack if you use their API.
# BETTERSTACK_UPTIME_API_TOKEN=

# GoHighLevel CRM intake (Path B). Optional. Signup still succeeds when these are unset.
# Independent of Resend / SMS. API and webhook failures never block signup.
# FEATURE_GHL_INTAKE=0 disables both the API and webhook POSTs. Unset flag = on.
#
# Preferred: Private Integration token. With only GHL_API_TOKEN set, the site calls
# LeadConnector directly (contact upsert + opportunity create). No inbound webhook
# workflow is required. Location defaults to KidEase Winnipeg (hkAJnVH8EJpMcgq9bNjG,
# casing matters). Pipeline and stage ids default to Daycare Sign Up / Parent Onboard
# at stage Signed up only. Never Approved. Auto-Approved is forbidden. Approved
# happens only after licence/screening. Do not point a stage override at Approved
# fd5410ec-da7b-48a7-8f34-32f3f58045c7 — the client refuses that id.
# Daycare Signed up default: 0ee9095f-b05e-4493-88ab-603bf85ce759
# Parent Signed up default: b219bee7-1593-4003-8798-d555883818ec
# Tags: source:website, type:daycare|parent, form:signup, plus claim:claimed for daycare.
# Claim verify also removes claim:unclaimed. That tag flip is not an approval.
#
# Optional dual-write: inbound webhook URLs, if set, still receive the signup JSON
# (email, name, phone, company, tags, kidease_event_id). That payload has no stage
# field. Webhook workflow authors must also use Signed up only. Never Approved.
# Daycare URL: provider signup, claim verify, and Enroll Now (/claim#enroll).
# Parent URL: parent signup. If only one URL is set, every webhook event POSTs there.
# The API path does not do that fallback: a provider role, claim, or enroll opens
# Daycare Sign Up only. Loading the app does not file a daycare as a parent.
# Parent Onboard is an explicit parent choice (set role parent, family, contact, search).
# Do not commit a real token or webhook URL.
# FEATURE_GHL_INTAKE=1
# GHL_API_TOKEN=
# GHL_LOCATION_ID=hkAJnVH8EJpMcgq9bNjG
# GHL_DAYCARE_PIPELINE_ID=y95txOBNvB7hOMMcXggS
# GHL_DAYCARE_SIGNED_UP_STAGE_ID=0ee9095f-b05e-4493-88ab-603bf85ce759
# GHL_PARENT_PIPELINE_ID=EyzRc2UAWPVOqfdmkoYh
# GHL_PARENT_SIGNED_UP_STAGE_ID=b219bee7-1593-4003-8798-d555883818ec
# GHL_WEBHOOK_DAYCARE_SIGNUP_URL=
# GHL_WEBHOOK_PARENT_ONBOARD_URL=

FEATURE_ENROLMENT_HANDOFF=0
# FEATURE_ENROLMENT_HANDOFF_LIVE=0
