{
  "crons": [
    {
      "path": "/api/digest",
      "schedule": "0 13 * * *"
    }
  ],
  "redirects": [
    { "source": "/explore", "destination": "/search", "permanent": true },
    { "source": "/childcare-benefits-program", "destination": "/benefits", "permanent": true },
    { "source": "/meet-the-team", "destination": "/team", "permanent": true },
    { "source": "/parent", "destination": "/login?role=parent", "permanent": false },
    { "source": "/faq", "destination": "/tour-checklist", "permanent": false },
    { "source": "/how-it-works", "destination": "/#how", "permanent": false }
  ],
  "rewrites": [
    { "source": "/apple-touch-icon.png", "destination": "/icon-512.png" },
    { "source": "/apple-touch-icon-precomposed.png", "destination": "/icon-512.png" },
    { "source": "/apple-touch-icon-180x180.png", "destination": "/icon-512.png" },
    { "source": "/apple-touch-icon-180x180-precomposed.png", "destination": "/icon-512.png" },
    { "source": "/app-icon", "destination": "/icon-512.png" },
    { "source": "/icon-192.png", "destination": "/icon-512.png" },
    { "source": "/icons/icon-180.png", "destination": "/icon-512.png" },
    { "source": "/icons/icon-192.png", "destination": "/icon-512.png" },
    { "source": "/icons/icon-512.png", "destination": "/icon-512.png" },
    { "source": "/icons/icon-1024.png", "destination": "/icon-512.png" }
  ],
  "headers": [
    {
      "source": "/photos/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/img",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/icon-512.png",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/app-icon",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }]
    },
    {
      "source": "/apple-touch-icon(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }]
    },
    {
      "source": "/icons/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
