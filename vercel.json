{
  "crons": [
    {
      "path": "/api/digest",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/search-alerts",
      "schedule": "20 * * * *"
    }
  ],
  "redirects": [
    { "source": "/.well-known/change-password", "destination": "/login", "permanent": false },
    {
      "source": "/admin",
      "has": [{ "type": "host", "value": "(.+)\\.vercel\\.app" }],
      "destination": "https://www.kidease.ca/admin",
      "permanent": false
    },
    {
      "source": "/admin/:path*",
      "has": [{ "type": "host", "value": "(.+)\\.vercel\\.app" }],
      "destination": "https://www.kidease.ca/admin/:path*",
      "permanent": false
    },
    {
      "source": "/admin-contracts",
      "has": [{ "type": "host", "value": "(.+)\\.vercel\\.app" }],
      "destination": "https://www.kidease.ca/admin-contracts",
      "permanent": false
    },
    {
      "source": "/admin-contracts/:path*",
      "has": [{ "type": "host", "value": "(.+)\\.vercel\\.app" }],
      "destination": "https://www.kidease.ca/admin-contracts/:path*",
      "permanent": false
    },
    {
      "source": "/admin-chat",
      "has": [{ "type": "host", "value": "(.+)\\.vercel\\.app" }],
      "destination": "https://www.kidease.ca/admin-chat",
      "permanent": false
    },
    {
      "source": "/admin-chat/:path*",
      "has": [{ "type": "host", "value": "(.+)\\.vercel\\.app" }],
      "destination": "https://www.kidease.ca/admin-chat/:path*",
      "permanent": false
    },
    {
      "source": "/api/admin/:path*",
      "has": [{ "type": "host", "value": "(.+)\\.vercel\\.app" }],
      "destination": "https://www.kidease.ca/api/admin/:path*",
      "permanent": false
    },
    {
      "source": "/support",
      "has": [{ "type": "host", "value": "(.+)\\.vercel\\.app" }],
      "destination": "https://www.kidease.ca/support",
      "permanent": false
    },
    {
      "source": "/support/:path*",
      "has": [{ "type": "host", "value": "(.+)\\.vercel\\.app" }],
      "destination": "https://www.kidease.ca/support/:path*",
      "permanent": false
    },
    { "source": "/explore", "destination": "/search", "permanent": true },
    { "source": "/childcare-benefits-program", "destination": "/benefits", "permanent": true },
    { "source": "/meet-the-team", "destination": "/team", "permanent": true },
    { "source": "/parent", "destination": "/login?role=parent", "permanent": false },
    { "source": "/how-it-works", "destination": "/#how", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(self), payment=(self), notifications=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" }
      ]
    },
    {
      "source": "/admin",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/admin-contracts",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/admin-chat",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/admin-chat/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/video",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), geolocation=(self), payment=(self)" }
      ]
    },
    {
      "source": "/video/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), geolocation=(self), payment=(self)" }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/support",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/support/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/daycare/test-ghost-claim-lab",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/book/test-ghost-claim-lab",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/photos/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/img",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/icon-512.png",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/app-icon",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }]
    },
    {
      "source": "/apple-touch-icon(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }]
    },
    {
      "source": "/icons/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/offline.html",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/.well-known/apple-app-site-association.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
